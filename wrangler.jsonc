{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stremio-streams",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS"
  },
  "vars": {
    "BASE_URL": "https://f2my.top"
  }
}
